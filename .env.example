# Copier vers .env.local puis renseigner les valeurs.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=jobboard

JWT_SECRET=change-moi-en-production
JWT_EXPIRES_IN=24h

# URL publique (SEO, sitemap, Open Graph). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Redirection HTTPS en production (middleware). Mettre false pour désactiver.
# FORCE_HTTPS=true
